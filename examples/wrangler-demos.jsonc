{
	"name": "untestable-demos",
	"main": "demos-worker.mjs",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "./demos-dist",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "demo.untestable.dev", "custom_domain": true },
		{ "pattern": "demos.untestable.dev", "custom_domain": true }
	],
	"ai": { "binding": "AI" }
}
